@model IEnumerable<DepartmentResponse>
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Departments</h1>
        <p class="text-muted mb-0">Manage the organization departments.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Departments" asp-action="Create">
        <i class="fa-solid fa-folder-plus me-1"></i> Create Department
    </a>
</div>

@if (Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th>@Html.DisplayNameFor(d => d.Code)</th>
                            <th>@Html.DisplayNameFor(d => d.Name)</th>
                            <th>@Html.DisplayNameFor(d => d.CreatedOn)</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-center">
                        @foreach (var department in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(_ => department.Code)</td>
                                <td>@Html.DisplayFor(_ => department.Name)</td>
                                <td>@Html.DisplayFor(_ => department.CreatedOn)</td>

                                <partial name="ButtonsPartial" model="department.Id" />
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info mt-3">
        <h5 class="mb-1">No departments found</h5>
        <p class="mb-0 small">Try adding a new department first.</p>
    </div>
}

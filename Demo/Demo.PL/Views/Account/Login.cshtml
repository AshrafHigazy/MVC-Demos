@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="main-agileinfo">
    <div class="agileits-top">

        <h2 class="mb-4 text-center">Sign in to your account</h2>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Email address" />
                <span asp-validation-for="Email" class="text-warning small d-block mt-1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                <span asp-validation-for="Password" class="text-warning small d-block mt-1"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3 wthree-text">
                <label class="anim mb-0 d-flex align-items-center gap-2">
                    <input asp-for="RememberMe" class="checkbox" />
                    <span>Keep me signed in</span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">
                SIGN IN
            </button>
        </form>

        <p class="mt-4 mb-1 text-center">
            Don't have an account?
            <a asp-action="Register" class="text-decoration-underline">Register now</a>
        </p>
        <p class="mb-0 text-center">
            Forgot your password?
            <a asp-action="ForgetPassword" class="text-decoration-underline">Reset now</a>
        </p>
    </div>
</div>

@section Validation {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Home";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between">
                <div>
                    <h1 class="h3 mb-2">Welcome to Demo.PL</h1>
                    <p class="text-muted mb-3">
                        Simple demo application for managing <strong>Departments</strong> and <strong>Employees</strong> using ASP.NET Core MVC.
                    </p>
                    <p class="mb-0 small text-muted">
                        Built with <strong>ASP.NET Core</strong>, <strong>Entity Framework Core</strong> and <strong>Bootstrap</strong>.
                    </p>
                </div>
                <div class="mt-3 mt-md-0 d-flex gap-2">
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-primary">
                        <i class="fa-solid fa-sitemap me-1"></i> View Departments
                    </a>
                    <a asp-controller="Employees" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-users me-1"></i> View Employees
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center me-2" style="width:36px;height:36px;">
                        <i class="fa-solid fa-sitemap text-primary"></i>
                    </div>
                    <h5 class="card-title mb-0">Departments</h5>
                </div>
                <p class="card-text text-muted mb-2">
                    Manage your organization structure and define departments to group employees.
                </p>
                <a asp-controller="Departments" asp-action="Index" class="small text-decoration-none">
                    Go to Departments <i class="fa-solid fa-arrow-right-long ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center me-2" style="width:36px;height:36px;">
                        <i class="fa-solid fa-users text-success"></i>
                    </div>
                    <h5 class="card-title mb-0">Employees</h5>
                </div>
                <p class="card-text text-muted mb-2">
                    Add, edit, and view employees with their related department and details.
                </p>
                <a asp-controller="Employees" asp-action="Index" class="small text-decoration-none">
                    Go to Employees <i class="fa-solid fa-arrow-right-long ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center me-2" style="width:36px;height:36px;">
                        <i class="fa-solid fa-book-open text-info"></i>
                    </div>
                    <h5 class="card-title mb-0">Learn ASP.NET Core</h5>
                </div>
                <p class="card-text text-muted mb-2">
                    Want to go deeper? Explore official documentation and best practices for ASP.NET Core.
                </p>
                <a href="https://learn.microsoft.com/aspnet/core" class="small text-decoration-none" target="_blank" rel="noopener">
                    ASP.NET Core Docs <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

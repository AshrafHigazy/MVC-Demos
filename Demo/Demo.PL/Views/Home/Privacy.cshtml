@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h1 class="h4 mb-3">@ViewData["Title"]</h1>
                <p class="text-muted mb-4">
                    This page describes how Demo.PL collects, uses, and protects your information.
                </p>

                <h5 class="mb-2">1. Data we collect</h5>
                <p class="text-muted">
                    This demo application is mainly used for learning purposes. Any data you enter
                    (such as departments and employees) is stored only for demonstrating CRUD operations.
                </p>

                <h5 class="mt-4 mb-2">2. How we use your data</h5>
                <p class="text-muted">
                    The information you provide is used inside the system to show, edit, and manage records.
                    We do not share this data with third parties in this demo setup.
                </p>

                <h5 class="mt-4 mb-2">3. Authentication & security</h5>
                <p class="text-muted">
                    If authentication is enabled, your login information is used only to verify your identity
                    and control access to the system features.
                </p>

                <h5 class="mt-4 mb-2">4. For production use</h5>
                <p class="text-muted mb-0">
                    If you plan to use this project in a real environment, make sure to:
                </p>
                <ul class="text-muted">
                    <li>Configure HTTPS and secure connection strings.</li>
                    <li>Use proper identity management and password policies.</li>
                    <li>Add a full, legally compliant privacy policy for your organization.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

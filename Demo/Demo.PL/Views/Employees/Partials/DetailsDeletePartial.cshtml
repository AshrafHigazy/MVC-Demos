@model EmployeeDetailsResponse

<div class="row justify-content-center mb-4">
    <div class="col-md-4 text-center">
        <div class="mb-3">
            <img src="~/Data/Images/@Model.Image"
                 class="img-fluid rounded-circle shadow-sm"
                 alt="Employee's Image"
                 style="max-width: 180px; max-height: 180px;" />
        </div>
        <h4 class="mb-0">@Model.Name</h4>
        <p class="text-muted mb-1">@Model.Email</p>
        <span class="badge bg-primary">@Model.Department</span>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header border-bottom-0 pb-0">
        <ul class="nav nav-tabs card-header-tabs" id="employeeTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="general-tab" data-bs-toggle="tab"
                        data-bs-target="#general" type="button" role="tab"
                        aria-controls="general" aria-selected="true">
                    General
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="administration-tab" data-bs-toggle="tab"
                        data-bs-target="#administration" type="button" role="tab"
                        aria-controls="administration" aria-selected="false">
                    Administration
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body">
        <div class="tab-content" id="employeeTabsContent">
            <!-- General Tab Content -->
            <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="Department"></label>
                        <input asp-for="Department" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="Address"></label>
                        <input asp-for="Address" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="PhoneNumber"></label>
                        <input asp-for="PhoneNumber" class="form-control" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="Age"></label>
                        <input asp-for="Age" class="form-control" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="HiringDate"></label>
                        <input asp-for="HiringDate" class="form-control" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold" asp-for="Salary"></label>
                        <input asp-for="Salary" class="form-control" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" asp-for="Gender"></label>
                        <input asp-for="Gender" class="form-control" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" asp-for="EmployeeType"></label>
                        <input asp-for="EmployeeType" class="form-control" readonly />
                    </div>

                    <div class="col-md-12 mt-2">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" disabled />
                            <label class="form-check-label" asp-for="IsActive"></label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Administration Tab Content -->
            <div class="tab-pane fade" id="administration" role="tabpanel" aria-labelledby="administration-tab">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="CreatedBy"></label>
                        <input asp-for="CreatedBy" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="CreatedOn"></label>
                        <input asp-for="CreatedOn" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="LastModifiedBy"></label>
                        <input asp-for="LastModifiedBy" class="form-control" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" asp-for="LastModifiedOn"></label>
                        <input asp-for="LastModifiedOn" class="form-control" readonly />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

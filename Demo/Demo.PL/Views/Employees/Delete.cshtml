@model EmployeeDetailsResponse
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0 text-danger">Delete Employee</h1>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to list</a>
        </div>

        <div class="alert alert-warning">
            <strong>Warning:</strong> Are you sure you want to delete this employee? This action cannot be undone.
        </div>

        <partial name="Partials/DetailsDeletePartial" />

        <div class="mt-4 d-flex justify-content-end gap-2">
            <form method="post" asp-controller="Employees" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash me-1"></i> Delete
                </button>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</div>

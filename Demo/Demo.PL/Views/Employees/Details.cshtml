@model EmployeeDetailsResponse
@{
    ViewData["Title"] = "Employee Details";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Employee Details</h1>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to list</a>
        </div>

        <partial name="Partials/DetailsDeletePartial" />

        <div class="mt-4 d-flex justify-content-end gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
        </div>
    </div>
</div>

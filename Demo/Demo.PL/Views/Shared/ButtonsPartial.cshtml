@model int

<td class="text-center">
    <div class="btn-group btn-group-sm" role="group">
        <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model">
            <i class="fas fa-eye"></i> Details
        </a>
        <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@Model">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model">
            <i class="fas fa-trash"></i> Delete
        </a>
    </div>
</td>
